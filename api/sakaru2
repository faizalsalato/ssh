#!/bin/bash
# sakaru2 v2 - API wrapper for Vmess (Xray 26+ JSON)
export PATH="/usr/sbin:/usr/bin:/bin:$PATH"
set -euo pipefail

login="${1:-}"; dias="${2:-}"
[[ -z "$login" || -z "$dias" ]] && { echo "ERRO|USO: sakaru2 <login> <dias>"; exit 1; }
[[ ! "$login" =~ ^[a-zA-Z0-9_.-]{3,32}$ ]] && { echo "ERRO|login invalido"; exit 2; }
[[ ! "$dias" =~ ^[0-9]+$ || $dias -lt 1 || $dias -gt 365 ]] && { echo "ERRO|dias invalido"; exit 2; }

IP=$(curl -sS --max-time 5 ipv4.icanhazip.com 2>/dev/null || echo "82.165.182.12")
DOMAIN=$(cat /etc/xray/domain 2>/dev/null || echo "de.checker.mobi")
UUID=$(cat /proc/sys/kernel/random/uuid)
EXP=$(date -d "$dias days" +"%Y-%m-%d")

# Insert into JSON using python
python3 -c "
import json
d = json.load(open('/etc/xray/config.json'))
for i in d.get('inbounds',[]):
    if i.get('protocol')=='vmess' and 'clients' in i.get('settings',{}):
        i['settings']['clients'].append({'id':'$UUID','alterId':0,'email':'$login'})
json.dump(d, open('/etc/xray/config.json','w'), indent=2)
" 2>/dev/null

systemctl restart xray 2>/dev/null || true

tls_port=8443
nontls_port=80

tls_json='{"v":"2","ps":"VMESS_'$login'","add":"'$DOMAIN'","port":"'$tls_port'","id":"'$UUID'","aid":"0","net":"ws","path":"/vmess","type":"none","host":"'$DOMAIN'","tls":"tls"}'
notls_json='{"v":"2","ps":"VMESS_'$login'","add":"'$DOMAIN'","port":"'$nontls_port'","id":"'$UUID'","aid":"0","net":"ws","path":"/vmess","type":"none","host":"'$DOMAIN'","tls":"none"}'

link_tls="vmess://$(echo -n "$tls_json" | base64 -w0)"
link_notls="vmess://$(echo -n "$notls_json" | base64 -w0)"

echo "SUCESSO|$login|$UUID|$EXP|$IP|$DOMAIN|$link_tls|$link_notls"
