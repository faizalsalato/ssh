#!/bin/bash
# sakaru6 - API wrapper for Shadowsocks (non-interactive)
export PATH="/usr/sbin:/usr/bin:/bin:$PATH"
set -euo pipefail
login="${1:-}"; pass="${2:-}"; dias="${3:-}"
[[ -z "$login" || -z "$pass" || -z "$dias" ]] && { echo "ERRO|USO: sakaru6 <login> <pass> <dias>"; exit 1; }
[[ ! "$login" =~ ^[a-zA-Z0-9_.-]{3,32}$ ]] && { echo "ERRO|login invalido"; exit 2; }
[[ ! "$dias" =~ ^[0-9]+$ || $dias -lt 1 || $dias -gt 365 ]] && { echo "ERRO|dias invalido"; exit 2; }
DOMAIN="${DOMAIN:-de.checker.mobi}"
IP=$(curl -sS --max-time 5 ipv4.icanhazip.com 2>/dev/null || echo "82.165.182.12")
exp_date=$(date -d "$dias days" +"%Y-%m-%d")
# Add to xray config
sed -i "/#xray-shadowsocks$/a\\### $login $exp_date\n},{\"method\": \"chacha20-ietf-poly1305\",\"password\": \"$pass\",\"email\": \"$login\"" /etc/xray/config.json 2>/dev/null
systemctl restart xray 2>/dev/null || true
ss_link="ss://$(echo -n "chacha20-ietf-poly1305:$pass@$DOMAIN:443" | base64 -w0)#SS_$login"
echo "SUCESSO|$login|$pass|$exp_date|$IP|$DOMAIN|$ss_link"
