#!/bin/bash
# sakaru6 v2 - API wrapper for Shadowsocks TLS 654 (Xray 26+ JSON)
export PATH="/usr/sbin:/usr/bin:/bin:$PATH"
set -euo pipefail

login="${1:-}"; pass="${2:-}"; dias="${3:-}"
[[ -z "$login" || -z "$pass" || -z "$dias" ]] && { echo "ERRO|USO: sakaru6 <login> <pass> <dias>"; exit 1; }
[[ ! "$login" =~ ^[a-zA-Z0-9_.-]{3,32}$ ]] && { echo "ERRO|login invalido"; exit 2; }
[[ ! "$dias" =~ ^[0-9]+$ || $dias -lt 1 || $dias -gt 365 ]] && { echo "ERRO|dias invalido"; exit 2; }

IP=$(curl -sS --max-time 5 ipv4.icanhazip.com 2>/dev/null || echo "82.165.182.12")
DOMAIN=$(cat /etc/xray/domain 2>/dev/null || echo "de.checker.mobi")
EXP=$(date -d "$dias days" +"%Y-%m-%d")

python3 -c "
import json
d = json.load(open('/etc/xray/config.json'))
for i in d.get('inbounds',[]):
    if i.get('protocol')=='shadowsocks' and i.get('port')==654:
        i['settings']['clients'].append({'method':'chacha20-ietf-poly1305','password':'$pass','email':'$login'})
json.dump(d, open('/etc/xray/config.json','w'), indent=2)
" 2>/dev/null

systemctl restart xray 2>/dev/null || true

# Generate ss:// link
b64=$(echo -n "chacha20-ietf-poly1305:$pass@$DOMAIN:654" | base64 -w0)
link="ss://${b64}#SS_${login}"

echo "SUCESSO|$login|$pass|$EXP|$IP|$DOMAIN|$link"
