#!/bin/bash
# sakaru4 v2.1 - Trojan + salvar config
export PATH="/usr/sbin:/usr/bin:/bin:$PATH"
set -euo pipefail
login="${1:-}"; dias="${2:-}"
[[ -z "$login" || -z "$dias" ]] && { echo "ERRO|USO: sakaru4 <login> <dias>"; exit 1; }
[[ ! "$login" =~ ^[a-zA-Z0-9_.-]{3,32}$ ]] && { echo "ERRO|login invalido"; exit 2; }
[[ ! "$dias" =~ ^[0-9]+$ || $dias -lt 1 || $dias -gt 365 ]] && { echo "ERRO|dias invalido"; exit 2; }

IP=$(curl -sS --max-time 5 ipv4.icanhazip.com 2>/dev/null || echo "82.165.182.12")
DOMAIN=$(cat /etc/xray/domain 2>/dev/null || echo "de.checker.mobi")
PASS=$(cat /proc/sys/kernel/random/uuid)
EXP=$(date -d "$dias days" +"%Y-%m-%d")
CREATED=$(date -d "0 days" +"%Y-%m-%d")

# Check duplicate
if grep -qw "$login" /etc/xray/config.json 2>/dev/null; then echo "ERRO|usuario $login ja existe"; exit 3; fi

python3 -c "
import json
d = json.load(open('/etc/xray/config.json'))
for i in d.get('inbounds',[]):
    if i.get('protocol')=='trojan' and 'clients' in i.get('settings',{}):
        i['settings']['clients'].append({'password':'$PASS','email':'$login'})
json.dump(d, open('/etc/xray/config.json','w'), indent=2)
" 2>/dev/null
systemctl restart xray 2>/dev/null || true

link="trojan://${PASS}@${DOMAIN}:2083?type=ws&security=tls&host=${DOMAIN}&path=/trojan&allowInsecure=1&sni=${DOMAIN}#TROJAN_${login}"

mkdir -p /home/vps/public_html; chmod 755 /home/vps/ 2>/dev/null; chmod 755 /home/vps/public_html/ 2>/dev/null
cat > /home/vps/public_html/trojan-$login.txt << END
====================================================================
              XRAYS TROJAN WS - blaylook VPN
====================================================================
Remarks     : ${login}
Domain      : ${DOMAIN}
IP          : ${IP}
Port        : 2083
Password    : ${PASS}
Network     : ws
Path        : /trojan
TLS         : tls
Created     : ${CREATED}
Expired     : ${EXP}
====================================================================
Link        : ${link}
====================================================================
Config URL  : https://${IP}:8445/trojan-${login}.txt
====================================================================
END
chown www-data:www-data /home/vps/public_html/trojan-$login.txt 2>/dev/null || true

echo "SUCESSO|$login|$PASS|$EXP|$IP|$DOMAIN|$link"
