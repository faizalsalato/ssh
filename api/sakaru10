#!/bin/bash
# sakaru10 - API wrapper for PPTP (non-interactive)
export PATH="/usr/sbin:/usr/bin:/bin:$PATH"
set -euo pipefail
login="${1:-}"; pass="${2:-}"; dias="${3:-}"
[[ -z "$login" || -z "$pass" || -z "$dias" ]] && { echo "ERRO|USO: sakaru10 <login> <pass> <dias>"; exit 1; }
[[ ! "$login" =~ ^[a-zA-Z0-9_.-]{3,32}$ ]] && { echo "ERRO|login invalido"; exit 2; }
[[ ! "$dias" =~ ^[0-9]+$ || $dias -lt 1 || $dias -gt 365 ]] && { echo "ERRO|dias invalido"; exit 2; }
IP=$(curl -sS --max-time 5 ipv4.icanhazip.com 2>/dev/null || echo "82.165.182.12")
exp_date=$(date -d "$dias days" +"%Y-%m-%d")
echo "$login pptpd $pass *" >> /etc/ppp/chap-secrets 2>/dev/null || true
systemctl restart pptpd 2>/dev/null || true
echo "SUCESSO|$login|$pass|$exp_date|$IP"
