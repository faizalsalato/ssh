# ============================================================
# CONFIGURACAO CENTRALIZADA - Auto Script VPN
# ============================================================
# Edite este arquivo para personalizar URLs, portas e dominios
# sem precisar mexer em dezenas de scripts individuais.
# ============================================================

# -------------------------------------------------------
# REPOSITÓRIO GIT - URLs base para download dos scripts
# -------------------------------------------------------
GIT_USER="faizalsalato"
GIT_REPO="ssh"
GIT_BRANCH="main"
GIT_BASE="raw.githubusercontent.com/${GIT_USER}/${GIT_REPO}/${GIT_BRANCH}"

# URLs completas por serviço (sobrescreva se necessário)
SSH_REPO="${GIT_BASE}/ssh"
SSTP_REPO="${GIT_BASE}/sstp"
SSR_REPO="${GIT_BASE}/ssr"
SHADOWSOCKS_REPO="${GIT_BASE}/shadowsocks"
WIREGUARD_REPO="${GIT_BASE}/wireguard"
XRAY_REPO="${GIT_BASE}/xray"
IPSEC_REPO="${GIT_BASE}/ipsec"
BACKUP_REPO="${GIT_BASE}/ssh"   # set-br.sh está no diretório ssh/
WEBSOCKET_REPO="${GIT_BASE}/websocket"
OHP_REPO="${GIT_BASE}/ohp"
API_REPO="${GIT_BASE}/api"
GRPC_REPO="${GIT_BASE}/grpc"

# -------------------------------------------------------
# DOMÍNIO / MARCA
# -------------------------------------------------------
BRAND_NAME="blaylook"
BRAND_DOMAIN="blaylook.com"
BRAND_EMAIL="blaylooks@gmail.com"

# -------------------------------------------------------
# LOCALIZAÇÃO / TIMEZONE
# -------------------------------------------------------
TIMEZONE="America/Los_Angeles"
COUNTRY="US"
STATE="California"
LOCALITY="Los_Angeles"

# -------------------------------------------------------
# PORTAS PADRÃO
# -------------------------------------------------------
PORT_SSH="22, 2253"
PORT_DROPBEAR="443, 109, 143"
PORT_STUNNEL="443, 445"
PORT_OPENVPN_TCP="1194"
PORT_OPENVPN_UDP="2200"
PORT_OPENVPN_UDP53="53"
PORT_OPENVPN_SSL="990"
PORT_WS_TLS="443"
PORT_WS_HTTP="8880"
PORT_BADVPN="7100, 7200, 7300"
PORT_NGINX="89"
PORT_WIREGUARD="7070"
PORT_SSTP="444"
PORT_L2TP="1701"
PORT_PPTP="1732"
PORT_XRAY_VMESS_TLS="8443"
PORT_XRAY_VMESS_NTLS="80"
PORT_XRAY_VLESS_TLS="8443"
PORT_XRAY_VLESS_NTLS="80"
PORT_XRAY_TROJAN="2083"
PORT_XRAY_GRPC_VMESS="1180"
PORT_XRAY_GRPC_VLESS="2280"
PORT_TROJANGO="2087"
